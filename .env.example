# Copy this file to .env and adjust. Restart the app after changing it.

# ── Sign-in ───────────────────────────────────────────────────────────────
# Leave empty to run without a login screen.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-any-long-random-string
# true when served over HTTPS (production)
COOKIE_SECURE=false

# ── Email delivery ────────────────────────────────────────────────────────
# console = simulate (nothing leaves the laptop) · smtp = any SMTP mailbox · graph = Microsoft 365
EMAIL_PROVIDER=console
MAIL_FROM_NAME=Medical Affairs Team
MAIL_FROM_ADDRESS=
# Emails per minute. Defaults: 240 for console, 30 for smtp/graph (Exchange Online's per-mailbox limit).
# EMAIL_RATE_PER_MINUTE=30

# SMTP (EMAIL_PROVIDER=smtp). For Gmail: smtp.gmail.com, port 465, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Microsoft 365 via Graph (EMAIL_PROVIDER=graph). Needs an Entra ID app with
# the Mail.Send *application* permission and admin consent. MAIL_FROM_ADDRESS is the mailbox it sends as.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Database & files ──────────────────────────────────────────────────────
# Empty = embedded PostgreSQL stored in ./data (no install needed).
# Set to use a real server, e.g. postgres://user:pass@uat-host:5432/dispatch
DATABASE_URL=
# DATA_DIR=data

# ── Scheduler ─────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
# SCHEDULER_INTERVAL_SECONDS=15
# SCHEDULER_GRACE_MINUTES=120
# RETENTION_DAYS=56
